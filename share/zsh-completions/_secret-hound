#compdef secret-hound

# Zsh completion script for the SNIPER 'secret-hound' tool
# Version 2.0 - Fully context-aware for Filesystem vs. Git modes

_secret-hound() {
    local -a common_options
    local -a git_only_options
    local -a fs_only_options
    
    # --- Option Definitions ---

    # Common options available in both modes
    common_options=(
        '(-h --help)-h[Show the help screen]'
        '(-r --rules)--rules=[Path to a custom JSON rules file]:rules_file:_files -g "*.json"'
        '(-o --output)--output=[File to save the report (JSON format)]:output_file:_files'
        '(-c --confidence)--confidence=[Minimum confidence to report]:confidence:(low medium high)'
        '--include=[Only run specific rule IDs (comma-separated)]'
    )
    
    # Options specific to Git scanning mode
    git_only_options=(
        '--depth=[Depth of Git history to scan (default: 100)]'
    )
    
    # Options/arguments specific to Filesystem scanning mode
    fs_only_options=(
        '--no-hidden[Exclude hidden files and directories]'
        '*:path to scan:_files' # Positional argument for path
    )

    # --- Main Logic ---
    # Decide which set of completions to offer based on the presence of '--scan-git'
    if [[ " ${words[@]} " =~ " --scan-git " ]]; then
        # --- GIT MODE ---
        # In Git Mode, we don't complete positional paths.
        _arguments -s -S \
            $common_options \
            $git_only_options \
            '--scan-git[Scan the Git history of the current repository]' # Show the flag itself for context
    else
        # --- FILESYSTEM MODE (DEFAULT) ---
        # In Filesystem Mode, we offer path completion and the flag to switch to Git mode.
        _arguments -s -S \
            $common_options \
            $fs_only_options \
            '--scan-git[Switch to scanning Git history instead of the filesystem]'
    fi
}
