#!/usr/bin/env python3
# File: tools/secret-hound/bin/secret-hound
# Description: Main user-facing entry point (v2.0 - Final, Robust Version).
# - This version correctly handles argument parsing for new features.
# - It reliably processes line-delimited JSON from the C++ backend.
# - The final report logic is robust, only showing "No secrets found" if the
#   list of *successfully parsed* findings is empty.

import sys
import argparse
import subprocess
import json
import os
from pathlib import Path
from collections import defaultdict

# --- Core SNIPER Environment Integration ---
try:
    _PROJECT_ROOT = Path(__file__).resolve().parents[3]
    sys.path.insert(0, str(_PROJECT_ROOT))
    from lib.sniper_env import env, Colors
    env.log.name = "secret-hound"
except (ImportError, IndexError):
    # Fallback class for colors if the environment fails to load.
    class Colors:
        RESET = '\033[0m'; BOLD = '\033[1m'; RED = '\033[91m'
        GREEN = '\033[92m'; YELLOW = '\033[93m'; CYAN = '\033[96m'
        MAGENTA = '\033[95m'
    print(f"{Colors.RED}[CRITICAL ERROR] Could not initialize SNIPER environment.{Colors.RESET}", file=sys.stderr)
    sys.exit(1)

def get_tool_path(tool_name: str) -> str:
    """Finds the absolute path to a tool's compiled binary."""
    # Prioritize the central sniper/bin directory
    path = env.ROOT_DIR / "bin" / tool_name
    if not (path.is_file() and os.access(path, os.X_OK)):
        # Fallback to the tool's local bin directory for development environments
        path = env.ROOT_DIR / "tools" / "secret-hound" / "bin" / tool_name
        if not (path.is_file() and os.access(path, os.X_OK)):
            raise FileNotFoundError(f"Required binary '{tool_name}' not found or is not executable.")
    return str(path)

def run_backend_and_get_findings(command: list) -> list:
    """
    Executes a backend command, captures its stdout, and parses the
    line-delimited JSON output into a list of findings.
    """
    findings = []
    try:
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, encoding='utf-8')
        
        # Process findings line-by-line from the backend's stdout stream.
        for line in process.stdout:
            try:
                findings.append(json.loads(line))
            except json.JSONDecodeError:
                env.log.warning(f"Received malformed JSON line from backend: {line.strip()}")

        # After the process is done, check for any errors on stderr.
        stderr_output = process.stderr.read()
        if process.wait() != 0:
            env.log.error(f"Backend scanner exited with a non-zero status code:")
            for err_line in stderr_output.strip().split('\n'):
                print(f"  {Colors.RED}↳{Colors.RESET} {err_line}", file=sys.stderr)
                
    except FileNotFoundError:
        env.log.error(f"Backend command not found: '{command[0]}'. Please ensure the project is built correctly.")
    except Exception as e:
        env.log.error(f"An unexpected error occurred while running the backend process: {e}")
    return findings

def print_simplified_report(findings: list):
    """Renders a simplified, colored text report to the console."""
    if not findings:
        print(f"\n{Colors.GREEN}✔ No secrets were found based on the current rules and filters.{Colors.RESET}")
        return

    # Group findings by their source location (file path or commit/path tuple).
    grouped_findings = defaultdict(list)
    for f in findings:
        key = (f.get('commit'), f.get('original_path')) if 'commit' in f else f.get('file', 'unknown_file')
        grouped_findings[key].append(f)

    total_secrets = len(findings)
    total_locations = len(grouped_findings)
    print(f"\n{Colors.YELLOW}🔥 Found {total_secrets} potential secret(s) in {total_locations} unique location(s).{Colors.RESET}")
    print("-" * 70)

    for key, location_findings in sorted(grouped_findings.items()):
        # Print header for the location (file or Git commit).
        if isinstance(key, tuple):
            commit, path = key
            print(f"{Colors.BOLD}{Colors.CYAN}📄 {path}{Colors.RESET} {Colors.YELLOW}(commit {commit[:8]}){Colors.RESET}")
        else:
            path = key
            print(f"{Colors.BOLD}{Colors.CYAN}📄 {path}{Colors.RESET}")
            
        # Print each finding within that location.
        for finding in sorted(location_findings, key=lambda x: x.get('line', 0)):
            line_num = finding.get('line', '?')
            rule_id = finding.get('rule_id', 'Unknown')
            match_str = finding.get('match', '')
            
            # Truncate long matches for a cleaner display.
            if len(match_str) > 80:
                match_str = match_str[:77] + "..."

            print(f"  {Colors.MAGENTA}L{line_num:<4}{Colors.RESET} [{Colors.YELLOW}{rule_id:<20}{Colors.RESET}] {Colors.RED}'{match_str}'{Colors.RESET}")
        print() # Add a newline for better readability between locations.

def main():
    """Main entry point for the secret-hound script."""
    parser = argparse.ArgumentParser(prog="secret-hound", add_help=False, description="A hybrid Go/C++/Python tool to find secrets in files and Git history.")
    
    # --- Argument Definitions ---
    parser.add_argument("path", nargs='?', default=".", help="File or directory to scan. This is ignored if --scan-git is used.")
    parser.add_argument("-r", "--rules", help="Path to a custom JSON rules file.")
    parser.add_argument("-c", "--confidence", choices=['low', 'medium', 'high'], default='low', help="Minimum confidence level to report (default: low).")
    parser.add_argument("--include", help="A comma-separated list of rule IDs to exclusively scan for (e.g., AWS_KEY,GITHUB_TOKEN).")
    parser.add_argument("--no-hidden", action="store_true", help="Exclude hidden files and directories (names starting with '.'). By default, they are included.")
    parser.add_argument("--scan-git", action="store_true", help="Scan the Git history of the current repository instead of the filesystem.")
    parser.add_argument("--depth", type=int, default=100, help="Depth of Git history to scan (used with --scan-git).")
    parser.add_argument("-o", "--output", help="File to save the full report in JSON format.")
    parser.add_argument("-h", "--help", action="store_true", help="Show this help message.")
    
    args = parser.parse_args()

    if args.help:
        env.run_command(["python3", str(env.LIB_DIR / "help_renderer.py"), "--tool", "secret-hound"], capture_output=False)
        return 0

    findings = []
    try:
        backend_cmd = []
        if args.scan_git:
            env.log.info(f"Scanning Git history (depth: {args.depth})...")
            go_analyzer_path = get_tool_path("git_analyzer")
            core_scanner_path = get_tool_path("hound-core")
            backend_cmd = [go_analyzer_path, core_scanner_path, str(args.depth)]
            # TODO: Future enhancement - pass filter flags through the Go analyzer to the C++ core.
        else:
            env.log.info(f"Scanning filesystem path: {args.path}")
            core_scanner_path = get_tool_path("hound-core")
            backend_cmd = [core_scanner_path]
            
            if args.rules: backend_cmd.extend(["--rules", args.rules])
            if args.confidence: backend_cmd.extend(["--confidence", args.confidence])
            if args.include: backend_cmd.extend(["--include", args.include])
            if args.no_hidden: backend_cmd.append("--no-hidden")
            
            backend_cmd.append(args.path)

        findings = run_backend_and_get_findings(backend_cmd)

    except FileNotFoundError as e:
        env.log.error(str(e))
        return 1
    except KeyboardInterrupt:
        print() # Move to a new line after Ctrl+C
        env.log.warning("Scan cancelled by user.")
        return 1
    
    print_simplified_report(findings)

    if args.output:
        if findings:
            try:
                with open(args.output, 'w', encoding='utf-8') as f:
                    json.dump(findings, f, indent=2)
                env.log.success(f"Full report successfully saved to '{args.output}'")
            except Exception as e:
                env.log.error(f"Failed to save report to '{args.output}': {e}")
                return 1
        else:
            env.log.info("No findings to save to output file.")
            
    # Return a non-zero exit code if secrets were found, useful for CI/CD pipelines.
    return 1 if findings else 0

if __name__ == "__main__":
    sys.exit(main())